<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="160dp"
        android:paddingTop="36dp"
        android:paddingEnd="160dp"
        android:paddingBottom="36dp">

        <TextView
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Réglages de la source" />

        <TextView
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Entre les informations fournies par ton fournisseur IPTV. Elles restent uniquement sur ta box." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/typeXtream"
                style="@style/Btn"
                android:text="Identifiants (Xtream)" />

            <Button
                android:id="@+id/typeM3u"
                style="@style/Btn"
                android:text="Lien M3U" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupXtream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/server"
                style="@style/Field"
                android:hint="Adresse du serveur (ex : http://serveur.com:8080)"
                android:inputType="textUri" />

            <EditText
                android:id="@+id/username"
                style="@style/Field"
                android:hint="Nom d’utilisateur"
                android:inputType="text" />

            <EditText
                android:id="@+id/password"
                style="@style/Field"
                android:hint="Mot de passe"
                android:inputType="textPassword" />

            <TextView
                style="@style/Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:text="Format des chaînes (change si les chaînes ne se lancent pas)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/fmtTs"
                    style="@style/Btn"
                    android:text="MPEG-TS (.ts)" />

                <Button
                    android:id="@+id/fmtHls"
                    style="@style/Btn"
                    android:text="HLS (.m3u8)" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/groupM3u"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/m3uUrl"
                style="@style/Field"
                android:hint="Lien de la liste M3U (http://…)"
                android:inputType="textUri" />
        </LinearLayout>

        <EditText
            android:id="@+id/epgUrl"
            style="@style/Field"
            android:hint="Lien du guide des programmes XMLTV (facultatif)"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save"
                style="@style/Btn"
                android:text="Enregistrer et se connecter" />

            <Button
                android:id="@+id/reload"
                style="@style/Btn"
                android:text="Recharger les listes" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
